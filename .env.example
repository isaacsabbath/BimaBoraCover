# Django core
SECRET_KEY=django-insecure-your-secret-key-change-in-production
DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.local
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DATABASE_URL=postgres://postgres:password@localhost:5432/bima_afya

# JWT
JWT_ACCESS_TOKEN_LIFETIME_HOURS=24
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# GCP Document AI
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
GCP_PROJECT_ID=your-project-id
GCP_PROCESSOR_ID=your-processor-id
GCP_LOCATION=eu
KYC_CONFIDENCE_THRESHOLD=0.80

# Safaricom Daraja
DARAJA_CONSUMER_KEY=your-consumer-key
DARAJA_CONSUMER_SECRET=your-consumer-secret
DARAJA_SHORTCODE=174379
DARAJA_PASSKEY=your-passkey
DARAJA_CALLBACK_URL=https://your-ngrok-url/api/v1/payments/callback/
DARAJA_ENV=sandbox

# Africa's Talking
AT_API_KEY=your-api-key
AT_USERNAME=sandbox
AT_SENDER_ID=BimaAfya

# Azure Blob Storage
AZURE_ACCOUNT_NAME=your-account
AZURE_ACCOUNT_KEY=your-key
AZURE_CONTAINER=bima-afya-documents

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
