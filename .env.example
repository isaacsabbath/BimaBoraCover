# Django core
SECRET_KEY=django-insecure-your-secret-key-change-in-production
DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.local
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DATABASE_URL=postgres://postgres:password@localhost:5432/bima_afya

# JWT
JWT_ACCESS_TOKEN_LIFETIME_HOURS=24
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# GCP Document AI
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
GCP_PROJECT_ID=your-project-id
GCP_PROCESSOR_ID=your-processor-id
GCP_LOCATION=eu
KYC_CONFIDENCE_THRESHOLD=0.80

# Safaricom Daraja
DARAJA_CONSUMER_KEY=your-consumer-key
DARAJA_CONSUMER_SECRET=your-consumer-secret
DARAJA_SHORTCODE=174379
DARAJA_B2C_SHORTCODE=600000
DARAJA_PASSKEY=your-passkey
DARAJA_CALLBACK_URL=https://your-ngrok-url/api/v1/payments/callback/
DARAJA_ENV=sandbox
DARAJA_INITIATOR_NAME=testapi
DARAJA_SECURITY_CREDENTIAL=your-security-credential

# Africa's Talking
AT_API_KEY=your-api-key
AT_USERNAME=sandbox
AT_SENDER_ID=BimaAfya

# Azure Blob Storage
AZURE_ACCOUNT_NAME=your-account
AZURE_ACCOUNT_KEY=your-key
AZURE_CONTAINER=bima-afya-documents

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Blockchain Anchoring — Polygon Amoy testnet (BimaRegistry.sol)
# Get an RPC URL from https://www.alchemy.com/rpc/matic-amoy (free tier)
# Deploy the contract with scripts/deploy_registry.py to get the registry address
# Use a NEW wallet (not a personal one) for OPERATOR_PRIVATE_KEY, funded via
# https://www.alchemy.com/faucets/polygon-amoy
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology
BIMA_BORA_REGISTRY_ADDRESS=
OPERATOR_PRIVATE_KEY=
